# openGym on Windows: copy to ..\.env (gitignored). host\build.ps1 does this for you the first time.
# Ports and DATA_DIR live in host\ecosystem.config.cjs, not here.

# Passkeys are bound to this hostname. NEVER change it after the first registration.
RP_ID=gym.jordanwallace.me
ORIGIN=https://gym.jordanwallace.me
RP_NAME=openGym

# PIN gate on the front page (host\web-shim.mjs). Light access control, not real security.
# Changing it re-prompts every device. build.ps1 refuses to start with it empty.
ACCESS_PIN=

# Admin + invite-only: after registering your own passkey, put your uid (data\db.json →
# users[].id) here and set INVITE_ONLY=1.
#ADMIN_UIDS=
#INVITE_ONLY=1

# Sign-in lifetime in days (default 90).
#SESSION_DAYS=90
